<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN" "http://www.musicxml.org/dtds/partwise.dtd">
<score-partwise version="3.1">
  <work>
    <work-title>记号与表情</work-title>
  </work>
  <identification>
    <creator type="composer">第 31 节 · 记号与表情</creator>
    <encoding>
      <software>Music Theory Playground</software>
    </encoding>
  </identification>
  <part-list>
    <score-part id="P1">
      <part-name>Piano</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <!-- 1：速度记号 + 力度 + 圆滑线 -->
    <measure number="1">
      <attributes>
        <divisions>6</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <direction placement="above">
        <direction-type>
          <metronome><beat-unit>quarter</beat-unit><per-minute>120</per-minute></metronome>
        </direction-type>
        <sound tempo="120"/>
      </direction>
      <direction placement="below">
        <direction-type><dynamics><mf/></dynamics></direction-type>
      </direction>
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type>
        <notations><slur type="start" number="1"/></notations></note>
      <note><pitch><step>D</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type></note>
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type>
        <notations><slur type="stop" number="1"/></notations></note>
    </measure>
    <!-- 2：跳音 + 渐强 -->
    <measure number="2">
      <direction placement="below">
        <direction-type><wedge type="crescendo" number="1"/></direction-type>
      </direction>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type>
        <notations><articulations><staccato/></articulations></notations></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type>
        <notations><articulations><staccato/></articulations></notations></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type>
        <notations><articulations><staccato/></articulations></notations></note>
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type>
        <notations><articulations><staccato/></articulations></notations></note>
      <direction placement="below">
        <direction-type><wedge type="stop" number="1"/></direction-type>
      </direction>
    </measure>
    <!-- 3：延音线（同一个音接起来）+ 重音 -->
    <measure number="3">
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>12</duration><type>half</type>
        <tie type="start"/>
        <notations><articulations><accent/></articulations><tied type="start"/></notations></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>12</duration><type>half</type>
        <tie type="stop"/>
        <notations><tied type="stop"/></notations></note>
    </measure>
    <!-- 4：三连音 -->
    <measure number="4">
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>2</duration><type>eighth</type>
        <time-modification><actual-notes>3</actual-notes><normal-notes>2</normal-notes></time-modification>
        <notations><tuplet type="start" number="1"/></notations></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>2</duration><type>eighth</type>
        <time-modification><actual-notes>3</actual-notes><normal-notes>2</normal-notes></time-modification></note>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>2</duration><type>eighth</type>
        <time-modification><actual-notes>3</actual-notes><normal-notes>2</normal-notes></time-modification>
        <notations><tuplet type="stop" number="1"/></notations></note>
      <note><pitch><step>A</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type></note>
      <note><pitch><step>B</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type></note>
      <note><pitch><step>C</step><octave>5</octave></pitch><duration>6</duration><type>quarter</type></note>
    </measure>
    <!-- 5：反复记号从这里开始 -->
    <measure number="5">
      <barline location="left">
        <bar-style>heavy-light</bar-style>
        <repeat direction="forward"/>
      </barline>
      <direction placement="below">
        <direction-type><dynamics><f/></dynamics></direction-type>
      </direction>
      <note><pitch><step>G</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type></note>
      <note><pitch><step>F</step><octave>4</octave></pitch><duration>6</duration><type>quarter</type></note>
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>12</duration><type>half</type></note>
    </measure>
    <!-- 6：延长记号 + 反复回去 -->
    <measure number="6">
      <note><pitch><step>C</step><octave>4</octave></pitch><duration>24</duration><type>whole</type>
        <notations><fermata type="upright"/></notations></note>
      <barline location="right">
        <bar-style>light-heavy</bar-style>
        <repeat direction="backward"/>
      </barline>
    </measure>
  </part>
</score-partwise>
